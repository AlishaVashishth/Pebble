# Copy to .env and fill in real values. Never commit .env.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure Speech (narration)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: force a voice for every language (overrides the VOICE_MAP in config.py)
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# Azure Blob Storage (finished videos + public URLs).
# The container MUST already exist: Pebble never creates it. Pebble tries to set
# its access level to "Blob"; if that is not permitted, `run_local.py --doctor
# --blob` reports exactly what to change in the portal.
# Credentials: AZURE_STORAGE_CONNECTION_STRING, OR both
# AZURE_STORAGE_ACCOUNT_NAME and AZURE_STORAGE_ACCOUNT_KEY (alias: AZURE_STORAGE_KEY).
# Container name: AZURE_STORAGE_CONTAINER (alias: AZURE_STORAGE_CONTAINER_NAME).
# AZURE_STORAGE_PUBLIC_BASE_URL is an optional URL-base override; the default is
# https://<account>.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_PUBLIC_BASE_URL=

# HTTP API (python run_server.py). Optional: when PEBBLE_API_KEY is set, every
# endpoint except /health requires the header X-API-Key; when it is unset the API
# logs a warning and stays open, which is only safe on a laptop.
# PEBBLE_API_KEY=
# PEBBLE_HOST=127.0.0.1
# PEBBLE_PORT=8000

# Optional tuning
RENDER_QUALITY=m
MAX_GENERATION_ATTEMPTS=3
MAX_RENDER_RETRIES=3
# PEBBLE_MAX_OUTPUT_TOKENS=
# Layout audit mode: warn (default) logs layout problems and falls back never to
# the repair loop; strict makes a layout problem fail the scene instead.
# PEBBLE_AUDIT=warn
# Keep the heavy scratch folders (media, scenes, audio, muxed, frames,
# render_logs) after a successful upload, for debugging:
# PEBBLE_KEEP_WORKSPACE=1

# Cost tracking. Prices are USD per 1M units; the defaults below are ESTIMATES.
# Verify them against the Azure OpenAI and Azure Speech pricing pages for your
# deployment and region before trusting a cost total.
# LLM_INPUT_PRICE_PER_1M=0.25
# LLM_OUTPUT_PRICE_PER_1M=2.00
# TTS_PRICE_PER_1M_CHARS=16.00
# Optional: show totals in INR as well (e.g. 84.0)
# USD_TO_INR=
