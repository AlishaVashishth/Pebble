# Application Environment
APP_ENV=development
APP_NAME=Pebble
API_PREFIX=/api/v1
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pebble

# Security & Authentication
SECRET_KEY=change-me-to-a-secure-random-secret
JWT_SECRET=change-me-to-a-secure-random-jwt-secret
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Video Service Configuration
VIDEO_PROVIDER=mock
VIDEO_ENGINE_URL=http://localhost:8001
VIDEO_ENGINE_API_KEY=
VIDEO_JOB_TIMEOUT_MINUTES=30

# LLM Intent Classification (off | mock | azure | groq)
INTENT_PROVIDER=off
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
INTENT_TIMEOUT_SECONDS=10.0
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
