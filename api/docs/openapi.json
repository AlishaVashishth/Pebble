  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Text",
            "description": "Query text: problem name, number, DSA concept, or pasted code"
          },
          "programming_language": {
            "type": "string",
            "enum": [
              "python",
              "java",
              "cpp"
            ],
            "title": "Programming Language",
            "description": "Target programming language (python, java, cpp)",
            "default": "python"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AskRequest",
        "description": "Payload for POST /ask."
      },
      "AskResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "found",
              "no_solution",
              "clarify",
              "concept",
              "out_of_scope"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProblemInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "solution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SolutionInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "available_languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Languages"
          },
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CandidateInfo"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidates"
          },
          "can_generate": {
            "type": "boolean",
            "title": "Can Generate"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "can_generate"
        ],
        "title": "AskResponse",
        "description": "Response structure for POST /ask."
      },
      "CandidateInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title"
        ],
        "title": "CandidateInfo",
        "description": "Potential problem candidate for ambiguous queries."
      },
      "CandidateItem": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemItem"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Trigram match similarity score [0.0 - 1.0]"
          }
        },
        "type": "object",
        "required": [
          "problem",
          "score"
        ],
        "title": "CandidateItem",
        "description": "Fuzzy search candidate with trigram similarity score."
      },
      "CreateVideoJobRequest": {
        "properties": {
          "problem_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem Id",
            "description": "LeetCode problem number (optional)"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Unmatched question or concept (max 300 chars)"
          },
          "user_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Code",
            "description": "User submitted code block (optional)"
          },
          "programming_language": {
            "type": "string",
            "title": "Programming Language",
            "description": "Target programming language (python, java, cpp)"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Legacy problem title (optional)"
          },
          "explanation_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Language",
            "description": "Legacy explanation language (optional)"
          },
          "explanation_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Style",
            "description": "Legacy explanation style (optional)"
          }
        },
        "type": "object",
        "required": [
          "programming_language"
        ],
        "title": "CreateVideoJobRequest",
        "description": "Payload to initiate a video generation job."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "db": {
            "type": "boolean",
            "title": "Db"
          }
        },
        "type": "object",
        "required": [
          "db"
        ],
        "title": "HealthResponse",
        "description": "Health check response schema."
      },
      "HistoryItemResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HistoryProblemInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "programming_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Programming Language"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "status",
          "created_at"
        ],
        "title": "HistoryItemResponse",
        "description": "History item returned by GET /history."
      },
      "HistoryProblemInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title"
        ],
        "title": "HistoryProblemInfo",
        "description": "Problem metadata reference in history response."
      },
      "ProblemDetailResponse": {
