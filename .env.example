# Copy to .env and fill in real values. Never commit .env.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure Speech (narration)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: force a voice for every language (overrides the VOICE_MAP in config.py)
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# Optional tuning
RENDER_QUALITY=m
MAX_GENERATION_ATTEMPTS=3
MAX_RENDER_RETRIES=3
# PEBBLE_MAX_OUTPUT_TOKENS=
# Layout audit mode for a single render (the pipeline turns it on for the first
# attempt and falls back to warn mode if a scene still fails after repairs).
# PEBBLE_LAYOUT_STRICT=1

# Cost tracking. Prices are USD per 1M units; the defaults below are ESTIMATES.
# Verify them against the Azure OpenAI and Azure Speech pricing pages for your
# deployment and region before trusting a cost total.
# LLM_INPUT_PRICE_PER_1M=0.25
# LLM_OUTPUT_PRICE_PER_1M=2.00
# TTS_PRICE_PER_1M_CHARS=16.00
# Optional: show totals in INR as well (e.g. 84.0)
# USD_TO_INR=
